FROM node:24-alpine

# ffmpeg: small video proxies for the local Immich (previews/CLIP/faces are generated by Immich from those)
# su-exec: drop from root to "node" after fixing DATA_DIR ownership (docker-entrypoint.sh)
RUN apk add --no-cache ffmpeg tini su-exec \
  && mkdir -p /data /app \
  && chown node:node /data

WORKDIR /app
COPY package.json LICENSE ./
COPY src ./src
COPY public ./public
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod 755 /usr/local/bin/docker-entrypoint.sh

ENV NODE_ENV=production \
    PORT=2283 \
    DATA_DIR=/data \
    IMMICH_URL=http://immich-server:2283 \
    NODE_NO_WARNINGS=1

VOLUME ["/data"]
EXPOSE 2283

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/federation/api/health" >/dev/null || exit 1

# runs as root only until docker-entrypoint.sh has fixed /data ownership, then as uid 1000 (node)
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "src/main.ts"]
